{
  "name": "budget-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev:web": "node scripts/build-wasm.mjs && vite --mode web",
    "build:web": "node scripts/build-wasm.mjs && vite build --mode web --outDir dist-web",
    "test": "node --test --test-force-exit --test-timeout=120000 \"src/**/*.test.js\"",
    "tauri": "tauri",
    "test:firebase": "npx --yes firebase-tools@14 emulators:exec --only auth,firestore --project demo-vault \"node --test --test-force-exit --test-timeout=120000 scripts/test-firebase.mjs\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "1.2.0"
  }
}
